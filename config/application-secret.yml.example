# 本地凭据配置示例。复制为 config/application-secret.yml 后填写真实值。
spring:
  datasource:
    password: "replace-me-database-password"

app:
  jwt:
    app-secret: "replace-me-with-random-app-secret"
    admin-secret: "replace-me-with-random-admin-secret"
  internal:
    token: "replace-me-with-local-internal-token"
  oss:
    access-key-id: "replace-me"
    access-key-secret: "replace-me"
  bootstrap-admin:
    username: "admin"
    password: "replace-me-strong-initial-password"
