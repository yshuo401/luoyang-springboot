# ===== Required local/runtime variables =====
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Infrastructure
MYSQL_HOST=192.168.100.128
MYSQL_PORT=3306
MYSQL_DATABASE=luoyang_tourism
MYSQL_USERNAME=luoyang_app
MYSQL_PASSWORD=replace-me
# 使用 deploy/sql/luoyang_tourism_init.sql 手动初始化后设为 7；正常空库 Flyway 初始化保持 1。
FLYWAY_BASELINE_VERSION=1
REDIS_HOST=192.168.100.128
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT: each secret must be at least 32 UTF-8 bytes and must differ by environment.
JWT_ISSUER=luoyang-tourism
JWT_APP_SECRET=replace-me-with-random-app-secret
JWT_ADMIN_SECRET=replace-me-with-random-admin-secret

# Internal Java <-> FastAPI HMAC
INTERNAL_SHARED_SECRET=replace-me-with-random-internal-secret
INTERNAL_TIMESTAMP_TOLERANCE_SECONDS=300
AI_SERVICE_BASE_URL=http://127.0.0.1:8000

# Alibaba Cloud OSS. Values belong only in this process, never in frontend or AI service.
APP_OSS_ENABLED=true
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=luoyang-smart-tourism
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me

# WeChat
WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
WECHAT_MOCK_ENABLED=false

# First-run admin bootstrap. Use only in local/controlled environments.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-and-change-after-first-login
BOOTSTRAP_ADMIN_NICKNAME=系统管理员

CORS_ALLOWED_ORIGINS=http://localhost:5173
